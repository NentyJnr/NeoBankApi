@model Account

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Create Account</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post" class="row">
            <div class="border p-3">
                @*//padding is 3,margin-top is 4*@

                @*<div asp-validation-summary="All"></div>*@
                <div class="form-floating py-2 col-12">
                    <input asp-for="AccountName" class="form-control border-0 shadow" placeholder="Enter full name" required />
                    <label asp-for="AccountName" class="ms-2"></label>
                    <span asp-validation-for="AccountName" class="text-danger"></span>
                </div>

                <div class="form-floating py-2 col-12 pt-4">
                    <input asp-for="Email" class="form-control border-0 shadow" type="email" placeholder="Enter email" required />
                    <label asp-for="Email" class="ms-2"></label>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
               
                <div class="form-floating py-2 col-12 pt-4">
                    <input asp-for="AccountBalance" class="form-control border-0 shadow" type="number" min="0" value="0" required />
                    <label asp-for="AccountBalance" class="ms-2"></label>
                    <span asp-validation-for="AccountBalance" class="text-danger"></span>
                </div> 

                <div class="row pt-5">
                    <div class="col-6 col-md-3">
                        <button type="submit" class="btn btn-primary form-control">Create</button>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Bank" asp-action="Index" class="btn btn-outline-primary border form-control">
                            Back to List
                        </a>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>





@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}