@model List<Account>
<partial name="_Notification" />


<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2"> Client List</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row pb-3">
            <div class="col-6">
            </div>
            <div class="col-6 text-end">
                <a asp-controller="Bank" asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle-dotted"></i>New Account
                </a>
            </div>
        </div>
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>
                        Account Name
                    </th>
                    <th>
                         Email
                    </th>
                    <th>
                        Account Number
                    </th>
                    <th>
                        Account Balance
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model.OrderBy(o => o.AccountName)) //The orderby is to format it Alphabetically
                {
                    <tr>
                        <td>@obj.AccountName</td>
                        <td>
                            @obj.Email
                        </td>
                        <td>
                            @obj.AccountNumber
                        </td>
                        <td>@obj.AccountBalance.ToString("C0", new System.Globalization.CultureInfo("en-US"))</td>
                        <td>
                            <div class="w-75 btn-group" role="group">
                                <a asp-controller="Bank" asp-action="Deposit" asp-route-id="@obj.Id" class="btn btn-primary mx-2">
                                   <i class="bi bi-cash-stack"></i> Deposit
                                </a>
                                <a asp-controller="Bank" asp-action="Balance" asp-route-id="@obj.Id" class="btn btn-primary mx-2">
                                    <i class="bi bi-wallet2"></i> Check Balance
                                </a>
                                <a asp-controller="Bank" asp-action="Transfer" asp-route-id="@obj.Id" class="btn btn-primary mx-2">
                                    <i class="bi bi-arrow-left-right"></i> Transfer
                                </a>
                                <a asp-controller="Bank" asp-action="Withdraw" asp-route-id="@obj.Id" class="btn btn-danger mx-2">
                                    <i class="bi bi-cash-coin"></i> Withdraw
                                </a>
                                <a asp-controller="Bank" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-danger mx-2">
                                    <button type="submit" class="btn btn-danger mx-2">
                                        <i class="bi bi-trash-fill"></i> Delete
                                    </button>
                                </a>
                            </div>
                            
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
