@using NeoBank.Dto
@model BalanceDto

<partial name="_Notification" />

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Account Balance</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="border p-3">
            <p class="h4">Your Account Balance is: @Model.AccountBalance.ToString("C2", new System.Globalization.CultureInfo("en-US"))</p>
            <div class="row pt-4">
                <div class="col-6 col-md-3">
                    <a asp-controller="Bank" asp-action="Index" class="btn btn-primary form-control">
                        <i class="bi bi-arrow-left-circle"></i> Back to Accounts
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
